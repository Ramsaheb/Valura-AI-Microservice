# Optional: Set this to use the real OpenAI API instead of the rule-based fallback
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Set to 'test' to force the use of the MockLLM locally without deleting the key
APP_ENV=development
